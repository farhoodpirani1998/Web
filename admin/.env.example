# Admin Panel — environment variables.

# Base URL of the CMS admin API (NestJS `@Controller('admin/auth')` etc.).
# This is the CMS API base URL; the public frontend uses its own
# `/public` base URL.
VITE_ADMIN_API_BASE_URL=http://localhost:3100/admin

# Human-readable label for the running app instance (diagnostics only).
VITE_APP_ENV=development
