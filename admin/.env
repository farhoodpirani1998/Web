# Admin Panel — environment variables.

# Base URL of the CMS admin API (NestJS `@Controller('admin/auth')` etc.).
# This is the ONLY backend the admin app ever talks to — never the SMS
# JWT/public API base URL used by `frontend/.env.example`.
VITE_ADMIN_API_BASE_URL=https://fuzzy-space-dollop-wvvgvvrqgx7j357xg-3100.app.github.dev/admin

# Human-readable label for the running app instance (diagnostics only).
VITE_APP_ENV=development
