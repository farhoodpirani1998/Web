{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": ".*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "<rootDir>/tsconfig.json" }]
  },
  "moduleNameMapper": {
    "^sanitize-html$": "<rootDir>/__mocks__/sanitize-html.js"
  },
  "testEnvironment": "node",
  "testTimeout": 30000
}
