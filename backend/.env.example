# --- Runtime environment ---
# Required for the production synchronize safety check (see
# src/config/database-synchronize.config.ts). Must be exactly "production"
# in production deployments — the app refuses to start with synchronize
# enabled while this is set to "production".
NODE_ENV=development

# --- This backend's own database (independent from SMS's database) ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=nhg_website
DATABASE_USER=nhg_website
DATABASE_PASSWORD=changeme
# Auto-sync entities to schema. Defaults to on outside production, off in
# production, and startup fails hard if this ever resolves to true while
# NODE_ENV=production. Leave unset in production; use migrations instead.
DATABASE_SYNCHRONIZE=true

# --- SMS identity trust (public-key verification only — no shared DB, no shared secret) ---
# The RS256 public key SMS signs user JWTs with. This backend verifies signatures only;
# it never calls into SMS's database or shares its RBAC tables.
SMS_JWT_PUBLIC_KEY_PATH=./keys/sms-public-key.pem
SMS_JWT_ISSUER=nhg-sms

# --- CMS Admin local identity (see modules/website/identity/auth/) ---
# Symmetric secret this backend uses to sign AND verify its own CMS
# Admin access tokens (HS256). Unlike the SMS keys above, there is no
# separate public/private pair — this backend is both issuer and
# verifier, so generate a long, random value and keep it secret
# (e.g. `openssl rand -base64 48`). Required, minimum 32 characters —
# there is no safe default and a short secret is brute-forceable.
CMS_JWT_SECRET=
# Optional; defaults to "nhg-cms" if unset.
CMS_JWT_ISSUER=nhg-cms
# Optional; defaults to "15m" if unset. Kept short since a CMS token
# is not re-checked against the database on every request (only at
# login and at GET /admin/auth/me) — see CmsAuthGuard's doc comment.
CMS_JWT_EXPIRES_IN=15m
# Only read by `npm run bootstrap:admin` (src/scripts/bootstrap-admin.script.ts),
# never by the running app — not validated by env-validation.config.ts.
# Set these as one-off environment variables when running that script,
# not as permanent entries here.
# CMS_BOOTSTRAP_ADMIN_EMAIL=
# CMS_BOOTSTRAP_ADMIN_PASSWORD=

# --- CMS Admin login throttle (see identity/auth/cms-auth-rate-limit.constants.ts) ---
# Dedicated, tighter override of THROTTLE_DEFAULT_* above, applied only
# to POST /admin/auth/login (brute-force protection). Both optional;
# left unset, falls back to 5 attempts per 300s (5 minutes). Does not
# apply to any other route, including GET /admin/auth/me.
THROTTLE_CMS_LOGIN_TTL_MS=300000
THROTTLE_CMS_LOGIN_LIMIT=5

# --- CMS Admin persistent login (see identity/auth/cms-refresh-cookie.util.ts) ---
# httpOnly refresh-token cookie that lets an admin silently obtain a new
# short-lived access token (CMS_JWT_EXPIRES_IN) without logging in again.
# All optional.
# Cookie name. Defaults to "cms_refresh_token" if unset.
CMS_REFRESH_COOKIE_NAME=cms_refresh_token
# How long a refresh token (and its cookie) stays valid before the admin
# must log in again from scratch. Defaults to 30 days if unset.
CMS_REFRESH_TOKEN_EXPIRES_IN_DAYS=30
# Cookie's Secure attribute. Defaults to true when NODE_ENV=production,
# false otherwise (so local HTTP development still receives it back).
CMS_REFRESH_COOKIE_SECURE=
# Cookie's SameSite attribute: "lax" | "strict" | "none". Defaults to
# "lax", which covers an admin SPA and this API sharing a registrable
# domain on different ports/subdomains. Use "none" (which additionally
# requires CMS_REFRESH_COOKIE_SECURE=true) if they're on genuinely
# different sites.
CMS_REFRESH_COOKIE_SAMESITE=lax

# --- CMS Admin refresh throttle (see identity/auth/cms-auth-rate-limit.constants.ts) ---
# Dedicated, more generous override of THROTTLE_DEFAULT_* above, applied
# only to POST /admin/auth/refresh. Both optional; left unset, falls
# back to 30 attempts per 300s (5 minutes).
THROTTLE_CMS_REFRESH_TTL_MS=300000
THROTTLE_CMS_REFRESH_LIMIT=30

# --- Object storage (S3-compatible: AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO) ---
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
LOCAL_STORAGE_PATH=./uploads

# --- Media upload limits (see media.constants.ts) ---
# Byte ceiling for a single media upload. Left unset, falls back to the
# previous hardcoded 10MB (10485760 bytes).
MEDIA_MAX_SIZE_BYTES=10485760
# Comma-separated subset of the formats below — these are the only
# ones media.constants.ts can verify by actual file content (magic
# bytes); listing anything else here is ignored. Left unset/empty, all
# of the following are allowed.
MEDIA_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
# Comma-separated subset of the extensions below — keep in sync with
# MEDIA_ALLOWED_MIME_TYPES above (e.g. drop both image/webp and .webp
# together). Left unset/empty, all of the following are allowed.
MEDIA_ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.webp

# --- Trust proxy (see main.ts) ---
# Set this when the app runs behind a reverse proxy/load balancer (nginx,
# ALB, Cloudflare, etc) so express reads the real client IP from
# X-Forwarded-For instead of the proxy's own address — matters for
# throttling and any IP-based logic. Accepts "true", a hop count (e.g.
# "1" for a single trusted proxy), or a comma-separated list of specific
# IPs/CIDR ranges/keywords ("loopback,linklocal,uniquelocal"). Left
# unset/empty, falls back to "false" (today's default, unchanged) — fine
# for local development without a proxy in front.
TRUST_PROXY=

# --- HSTS (see main.ts) ---
# Explicit override of helmet's built-in Strict-Transport-Security
# defaults. All optional; left unset/empty, each falls back to
# helmet's own default below (unchanged behavior). Harmless to leave
# set in local development — browsers only act on this header over
# HTTPS.
HSTS_MAX_AGE_SECONDS=15552000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false

# --- CORS (see main.ts) ---
# Comma-separated allow-list of origins allowed to read responses from a
# browser, e.g. "https://nhg.example,https://admin.nhg.example".
# REQUIRED when NODE_ENV=production — startup fails otherwise (see
# validateEnvironment in src/config/env-validation.config.ts). Left
# unset/empty outside production, the caller's own Origin header is
# reflected back (permissive, like the old "*" default, but compatible
# with the credentialed requests the CMS Admin refresh-token cookie
# needs — see identity/auth/cms-refresh-cookie.util.ts). Admin routes
# are still protected by the SMS-JWT/CMS guards regardless of origin —
# this only controls which origins a browser will let read the response.
CORS_ALLOWED_ORIGINS=

# --- Request payload limits (see main.ts) ---
# Byte ceiling for a single JSON / urlencoded request body (protects
# against oversized-payload abuse). Both optional; left unset, each
# falls back to 1 MiB (1048576 bytes) below — more generous than
# express's own built-in 100kb default, but still bounded.
BODY_LIMIT_JSON_BYTES=1048576
BODY_LIMIT_URLENCODED_BYTES=1048576

# --- Public site (see public-api/sitemap/public-sitemap.controller.ts) ---
# Absolute origin the public site is served at, no trailing slash, e.g.
# "https://nedayehaghighat.example". Used to build absolute <loc> URLs
# in /sitemap.xml. Left unset, falls back to http://localhost:{PORT}.
PUBLIC_SITE_URL=

PORT=3100

# --- API documentation (see main.ts) ---
# Swagger UI + OpenAPI JSON are mounted at /api/docs. On by default
# outside production; set to "true" to opt into exposing them in a
# production deployment too.
SWAGGER_ENABLED=false

# --- Error reporting (see main.ts) ---
# DSN for the Sentry project unexpected (5xx) server errors are reported
# to (see GlobalExceptionFilter). Optional — left unset, Sentry is never
# initialized and error reporting stays local-log-only, same as before.
SENTRY_DSN=

# Optional. Falls back to NODE_ENV when unset — only set this if an
# environment needs a Sentry label different from its NODE_ENV.
SENTRY_ENVIRONMENT=

# --- Redis (see core/redis/redis.module.ts) ---
# Connection for RedisService (get/set-with-TTL/delete). All optional —
# left unset, defaults to a local Redis on its standard port with no
# auth, db 0.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# --- Rate limiting (see app.module.ts / public-api/common/public-rate-limit.constants.ts) ---
# All optional. TTL is the throttling window in milliseconds; LIMIT is
# the max requests allowed per client within that window. Left unset,
# each falls back to today's values (shown below) — behavior is
# unchanged until a deployment opts in.
# Global floor applied to every route (admin, auth, public):
THROTTLE_DEFAULT_TTL_MS=60000
THROTTLE_DEFAULT_LIMIT=300
# Tighter override for public/* content-read endpoints:
THROTTLE_PUBLIC_TTL_MS=60000
THROTTLE_PUBLIC_LIMIT=120
# Stricter still, for any public endpoint that accepts user input (a
# contact/inquiry form, newsletter signup, etc) rather than only
# serving cached reads. No such endpoint exists in this codebase yet —
# this is configured and ready for the first one that's added.
THROTTLE_PUBLIC_FORM_TTL_MS=60000
THROTTLE_PUBLIC_FORM_LIMIT=5
