# Copy to .env and replace every placeholder before deployment.
SITE_DOMAIN=example.com
ADMIN_DOMAIN=admin.example.com
API_DOMAIN=api.example.com

# Must match backend/.env DATABASE_NAME / USER.
DATABASE_NAME=nhg_website
DATABASE_USER=nhg_website
DATABASE_PASSWORD=replace-with-a-long-random-password

# Must be the SMS JWT verification public key, never the private key.
SMS_JWT_PUBLIC_KEY_FILE=./backend/keys/sms-public-key.pem

# Browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=https://example.com,https://admin.example.com
